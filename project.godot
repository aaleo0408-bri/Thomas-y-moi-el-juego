; Engine configuration file.
; T/Gravity - original landscape pixel platformer
config_version=5

[application]
config/name="T / Gravity"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="Plataformas de gravedad invertida: tres mundos, cinco vidas y 16 bits."

[display]
window/size/viewport_width=1152
window/size/viewport_height=648
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/handheld/orientation=1
window/size/resizable=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.06, 0.09, 0.13, 1)

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194311)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194313)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32),Object(InputEventKey,"physical_keycode":4194309)]}
flip_gravity={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":71)]}

[physics]
2d/default_gravity=1050.0
2d/default_gravity_vector=Vector2(0, 1)

[gui]
theme/default_font_multichannel_signed_distance_field=true
